---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import { company } from '../data/site';

/* Znění odpovídá dokumentům, které dodal klient (docs/). Dřív tu stálo, že máme
 * oprávnění na *výrobu* zdvihacích zařízení a *revize* zdvihacích zařízení —
 * ani jedno v dokumentech není. Revize a zkoušky se týkají tlakových zařízení. */
const oblasti = [
  {
    title: 'Certifikace svařování',
    text: 'Certifikát ČSN EN ISO 3834-2:2022 pro proces svařování v rozsahu oprav strojů a jejich částí a zámečnické výroby (č. ZCV-25-314/C01, platný do 13. 6. 2030). Svařujeme hliník, litinu, bronz i nerez, včetně navařování otěruvzdorných vrstev.',
  },
  {
    title: 'Zdvihací zařízení',
    text: 'Oprávnění Technické inspekce ČR k montážím a opravám vyhrazených zdvihacích zařízení (ev. č. 358/24/ZZ-M,O-a,a1,a2,a5,a6,b,b1).',
  },
  {
    title: 'Tlaková zařízení',
    text: 'Oprávnění Technické inspekce ČR k revizím a zkouškám provozovaných tlakových zařízení a k montážím a opravám vyhrazených tlakových zařízení (ev. č. 1523/7/22/TZ-R,M-NA). Protokoly předáváme u zakázek, u nichž jsou vyžadovány.',
  },
];
---

<BaseLayout
  title="Certifikáty a oprávnění"
  description="Svářečská oprávnění, oprávnění na opravy a výrobu vyhrazených zdvihacích zařízení a ocelových konstrukcí, revize a zkoušky."
>
  <section class="section">
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Certifikáty a oprávnění' }]} />
      <div class="eyebrow"><span class="idx">01</span> Dokumenty</div>
      <h1 style="max-width: 22ch">Certifikáty a oprávnění</h1>
      <p style="font-size: 18px; color: #37475b; max-width: 62ch; margin-top: 18px">
        Práce, které děláme, jsou z velké části vyhrazené činnosti – smí je provádět
        jen firma s platným oprávněním a vyškolenými lidmi. Níže je přehled oblastí,
        které máme pokryté.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="wrap">
      <div class="linegrid cols-3">
        {oblasti.map((o) => (
          <div style="padding: 26px 24px">
            <h2 class="h4" style="margin-bottom: 10px">{o.title}</h2>
            <p style="font-size: 15px; color: #42566b; margin: 0">{o.text}</p>
          </div>
        ))}
      </div>

      <div style="border: 1px solid var(--color-line); padding: 26px 28px; margin-top: 32px; max-width: 70ch">
        <h2 class="h6">Dokumenty ke stažení</h2>
        <p style="font-size: 15px; color: #37475b; margin: 0">
          Potřebujete konkrétní certifikát nebo oprávnění doložit do zakázkové
          dokumentace? Napište na{' '}
          <a href={`mailto:${company.email}`}>{company.email}</a> a sken vám pošleme e-mailem.
        </p>
      </div>
    </div>
  </section>

  <CtaBand
    kicker="Potřebujete doložit oprávnění k zakázce?"
    title="Řekněte nám, o jaký dokument jde – pošleme ho"
    ctaLabel="Napsat nám →"
    href="/kontakt/"
  />
</BaseLayout>
