---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import Gallery from '../../components/Gallery.astro';

const sluzby = (await getCollection('sluzby')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Služby"
  description="Servis strojních zařízení a hydrauliky, svařování a renovace, strojní obrábění, zpracování plechů a 3D pálení plazmou. Jedna dílna, devět řemesel."
>
  <section class="section" style="padding-bottom: clamp(40px, 5vw, 64px)">
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Služby' }]} />
      <div class="eyebrow"><span class="idx">01</span> Služby</div>
      <h1 style="max-width: 20ch">Opravíme cokoliv – a co je potřeba, vyrobíme</h1>
      <p style="font-size: 18px; color: #37475b; max-width: 62ch; margin-top: 18px">
        Servis strojních zařízení, hydrauliky a mobilní techniky, svařování a renovace,
        strojní obrábění, zpracování plechů a 3D pálení plazmou. Jedna dílna, devět
        řemesel – od diagnostiky závady po dodávku hotového svařence.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="wrap">
      <div class="linegrid cols-3">
        {sluzby.map((s) => (
          <ServiceCard
            href={`/sluzby/${s.id}/`}
            index={s.data.order}
            title={s.data.title}
            body={s.data.excerpt}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap split">
      <div>
        <div class="eyebrow"><span class="idx">02</span> Od opravy k výrobě</div>
        <h2 style="max-width: 22ch">Oprava často končí výrobou lepšího dílu</h2>
        <p style="font-size: 17px; color: #37475b; max-width: 58ch">
          Když se díl nevyplatí opravovat, vyrobíme nový – vypálíme, ohneme, svaříme
          a obrobíme pod jednou střechou. U exponovaných dílů rovnou z otěruvzdorného
          materiálu, aby příště vydržel déle.
        </p>
        <div style="display: flex; flex-wrap: wrap; gap: 14px; margin-top: 24px">
          <a class="btn btn-primary" href="/sluzby/paleni-3d-plazmou/">3D pálení plazmou →</a>
          <a class="btn btn-secondary" href="/strojovy-park/">Strojový park</a>
        </div>
      </div>
      <div>
        <Gallery section="firma-vyroba" label="Zakázková kovovýroba" cols={2} limit={4} />
      </div>
    </div>
  </section>

  <CtaBand kicker="Stojí vám stroj?" title="Zavolejte Příjem oprav – domluvíme postup hned" />
</BaseLayout>
