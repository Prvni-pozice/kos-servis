---
import { inquiryTypes } from '../data/site';

interface Props {
  /** Předvyplněný typ poptávky podle stránky, ze které formulář vychází. */
  subject?: string;
  title?: string;
}

const { subject, title = 'Poptávkový formulář' } = Astro.props;
const selected = subject && inquiryTypes.includes(subject as never) ? subject : inquiryTypes[0];
---

<div style="border: 1px solid var(--color-line); padding: 30px; background: var(--color-paper)">
  <h3 style="margin-bottom: 18px">{title}</h3>

  <!-- Koncové lomítko je povinné: web běží s trailingSlash: 'always',
       bez něj by POST skončil na 404. -->
  <form id="poptavka" method="POST" action="/api/poptavka/" enctype="multipart/form-data" novalidate>
    <div class="form-msg ok" data-ok hidden></div>
    <div class="form-msg err" data-err hidden></div>

    <div class="field">
      <label for="typ">Typ poptávky</label>
      <select class="input" id="typ" name="typ">
        {inquiryTypes.map((t) => <option value={t} selected={t === selected}>{t}</option>)}
      </select>
    </div>

    <div class="field">
      <label for="jmeno">Jméno a firma</label>
      <input class="input" id="jmeno" name="jmeno" type="text" placeholder="Jan Novák, Firma s.r.o." required />
    </div>

    <div class="field">
      <label for="kontakt">Telefon nebo e-mail</label>
      <input class="input" id="kontakt" name="kontakt" type="text" placeholder="+420 …" required />
    </div>

    <div class="field">
      <label for="popis">Popis</label>
      <textarea class="input" id="popis" name="popis" placeholder="Stručně popište, co potřebujete…" required></textarea>
    </div>

    <div class="field">
      <label for="priloha">Příloha</label>
      <input
        id="priloha"
        name="priloha"
        type="file"
        multiple
        accept=".pdf,.dwg,.dxf,.jpg,.jpeg,.png,.heic,.zip"
        style="display: none"
      />
      <label class="file-drop" for="priloha">+ Přiložit výkres nebo fotku (do 10 MB)</label>
      <div class="file-list" data-files></div>
    </div>

    <!-- Past na roboty: skutečný návštěvník pole nikdy nevidí ani nevyplní. -->
    <div class="hp" aria-hidden="true">
      <label for="web">Nevyplňujte</label>
      <input id="web" name="web" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <p class="form-note">
      Odesláním souhlasíte se zpracováním údajů pro vyřízení poptávky.
      Podrobnosti v <a href="/ochrana-osobnich-udaju/">zásadách zpracování osobních údajů</a>.
    </p>

    <button class="btn btn-primary" type="submit">Odeslat poptávku →</button>
  </form>
</div>

<script>
  const form = document.querySelector<HTMLFormElement>('#poptavka');
  const ok = form?.querySelector<HTMLElement>('[data-ok]');
  const err = form?.querySelector<HTMLElement>('[data-err]');
  const fileInput = form?.querySelector<HTMLInputElement>('#priloha');
  const fileList = form?.querySelector<HTMLElement>('[data-files]');
  const MAX_BYTES = 10 * 1024 * 1024;

  fileInput?.addEventListener('change', () => {
    const files = Array.from(fileInput.files ?? []);
    const total = files.reduce((n, f) => n + f.size, 0);
    if (fileList) {
      fileList.textContent = files.length
        ? `${files.map((f) => f.name).join(', ')} · ${(total / 1024 / 1024).toFixed(1)} MB`
        : '';
    }
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!ok || !err) return;
    ok.hidden = true;
    err.hidden = true;

    // Validace v prohlížeči, ať uživatel nečeká na odpověď serveru zbytečně.
    const missing = ['jmeno', 'kontakt', 'popis'].filter(
      (n) => !(form.elements.namedItem(n) as HTMLInputElement)?.value.trim(),
    );
    if (missing.length) {
      err.textContent = 'Vyplňte prosím jméno, kontakt a popis poptávky.';
      err.hidden = false;
      (form.elements.namedItem(missing[0]) as HTMLInputElement)?.focus();
      return;
    }

    const total = Array.from(fileInput?.files ?? []).reduce((n, f) => n + f.size, 0);
    if (total > MAX_BYTES) {
      err.textContent = 'Přílohy dohromady přesahují 10 MB. Zmenšete je nebo pošlete odkaz na úložiště.';
      err.hidden = false;
      return;
    }

    const button = form.querySelector<HTMLButtonElement>('button[type=submit]');
    if (button) {
      button.disabled = true;
      button.textContent = 'Odesílám…';
    }

    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error ?? 'Odeslání se nezdařilo.');
      form.reset();
      if (fileList) fileList.textContent = '';
      ok.textContent = 'Děkujeme, poptávku máme. Ozveme se obvykle do jednoho pracovního dne.';
      ok.hidden = false;
    } catch (e2) {
      err.textContent =
        (e2 as Error).message +
        ' Zkuste to prosím znovu, nebo nám zavolejte — kontakty jsou vedle formuláře.';
      err.hidden = false;
    } finally {
      if (button) {
        button.disabled = false;
        button.textContent = 'Odeslat poptávku →';
      }
    }
  });
</script>
