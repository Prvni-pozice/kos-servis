---
interface Slogan {
  kicker: string;
  line: string;
}

interface Props {
  video: string;
  poster: string;
  slogans: Slogan[];
  /** Modrý tón sjednotí záběry s brandem – na kontaktu se nechává vypnutý. */
  tone?: boolean;
  /** Nižší pruh místo plného hero – používá kontakt. */
  band?: boolean;
  intervalSeconds?: number;
}

const { video, poster, slogans, tone = true, band = false, intervalSeconds = 6 } = Astro.props;
---

<div class:list={['hero', 'cut', { 'hero-band': band }]}>
  <img
    class="hero-poster"
    src={poster}
    alt=""
    width="1280"
    height="720"
    fetchpriority="high"
    decoding="async"
    data-hero-poster
  />
  {/* `src` se doplňuje až ze skriptu – jinak si video ukousne pásmo ještě před LCP. */}
  <video
    poster={poster}
    muted
    loop
    playsinline
    preload="none"
    data-hero-vid
    data-hero-src={video}
    data-active="false"
    aria-hidden="true"
  ></video>

  {tone && <div class="hero-tone"></div>}
  <div class="hero-scrim"></div>

  {slogans.map((s, i) => (
    <div class="hero-slogan" data-hero-slogan={i} data-active={i === 0 ? 'true' : 'false'}>
      <div class="kicker">{s.kicker}</div>
      <div class="line">{s.line}</div>
    </div>
  ))}

  {slogans.length > 1 && (
    <div class="hero-dashes">
      {slogans.map((s, i) => (
        <button type="button" data-hero-dash={i} aria-pressed={i === 0} aria-label={`Heslo ${i + 1}: ${s.line}`}></button>
      ))}
    </div>
  )}
</div>

<script is:inline define:vars={{ intervalSeconds }}>
  (() => {
    const hero = document.querySelector('.hero');
    if (!hero) return;
    const video = hero.querySelector('[data-hero-vid]');
    const poster = hero.querySelector('[data-hero-poster]');
    const slogans = [...hero.querySelectorAll('[data-hero-slogan]')];
    const dashes = [...hero.querySelectorAll('[data-hero-dash]')];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Video je ozdoba, ne obsah – poster nese sdělení sám. Proto se stahuje až
    // po `load` a v nečinné chvíli: dřív by soupeřilo o pásmo s posterem, který
    // je LCP prvek stránky. Na úsporném režimu a pomalé lince se nepouští vůbec.
    const conn = navigator.connection;
    const stingy =
      !!conn && (conn.saveData === true || /^(slow-)?2g$/.test(conn.effectiveType || ''));

    if (video && !reduced && !stingy) {
      const start = () => {
        video.muted = true;
        video.addEventListener(
          'canplay',
          () => {
            video.dataset.active = 'true';
            if (poster) poster.style.opacity = '0';
            video.play().catch(() => {});
          },
          { once: true },
        );
        video.src = video.dataset.heroSrc;
        video.load();
      };

      const idle = () =>
        'requestIdleCallback' in window
          ? requestIdleCallback(start, { timeout: 3000 })
          : setTimeout(start, 700);

      if (document.readyState === 'complete') idle();
      else window.addEventListener('load', idle, { once: true });
    }

    if (slogans.length < 2 || reduced) return;

    let idx = 0;
    let timer;

    const apply = (i) => {
      idx = (i + slogans.length) % slogans.length;
      slogans.forEach((el, k) => (el.dataset.active = String(k === idx)));
      dashes.forEach((el, k) => el.setAttribute('aria-pressed', String(k === idx)));
    };

    const schedule = () => {
      clearTimeout(timer);
      timer = setTimeout(() => {
        apply(idx + 1);
        schedule();
      }, intervalSeconds * 1000);
    };

    dashes.forEach((el, i) =>
      el.addEventListener('click', () => {
        apply(i);
        schedule();
      }),
    );

    // Když stránka není vidět, nemá smysl točit hesla dál.
    document.addEventListener('visibilitychange', () =>
      document.hidden ? clearTimeout(timer) : schedule(),
    );

    schedule();
  })();
</script>
