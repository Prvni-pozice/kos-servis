---
import { company, nav, footerDocs, intake } from '../data/site';

const year = new Date().getFullYear();
/** V patičce nechceme Úvod ani Kontakt – ten má vlastní sloupec. */
const links = nav.filter((n) => n.href !== '/' && n.href !== '/kontakt/');
---

<footer class="footer">
  <div class="wrap foot-grid">
    <div>
      <div style="font-family: var(--font-heading); font-weight: 800; font-size: 22px; color: #fff">
        {company.name}
      </div>
      <p style="font-size: 14px; margin-top: 12px; max-width: 34ch; color: #9fb6cd">
        Strojní opravy, zakázková výroba a 3D pálení plazmou. Chyšná u Pacova,
        Vysočina – dobrá dostupnost z D1.
      </p>
    </div>

    <div>
      <h2 class="h4">Web</h2>
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="h4">Dokumenty</h2>
      <ul>
        {footerDocs.map((d) => <li><a href={d.href}>{d.label}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="h4">Sídlo</h2>
      <ul>
        <li>{company.name}</li>
        <li>{company.street}, {company.city}</li>
        <li>IČ {company.ico} · DIČ {company.dic}</li>
        <li>{company.registration}</li>
        <li><a href={`mailto:${company.email}`}>{company.email}</a></li>
        <li>
          <a href={`tel:${intake.phoneHref}`}>{intake.label}: {intake.phone}</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="wrap legal">
    <span>© {year} {company.name}</span>
    <span>Web: První pozice s.r.o.</span>
  </div>
</footer>
