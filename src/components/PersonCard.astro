---
import type { Person } from '../data/site';

interface Props {
  person: Person;
}

const { person } = Astro.props;
const telHref = person.phone?.replace(/\s/g, '');
---

<div class="person">
  <div>
    <div class="role">{person.role}</div>
    <div class="name">{person.name}</div>
    <p class="solves">{person.solves}</p>
  </div>
  <div class="num">
    {person.phone && <a href={`tel:${telHref}`}>{person.phone}</a>}
    {person.email && (
      <>
        <br />
        <a href={`mailto:${person.email}`}>{person.email}</a>
      </>
    )}
    {/* `todo` je interní poznámka pro nás, ne pro návštěvníka – jen ve vývoji. */}
    {import.meta.env.DEV && person.todo && <span class="todo">{person.todo}</span>}
  </div>
</div>
